{
    "name": "marcelodelgado/filament-announcements",
    "description": "Filament v5 plugin for institutional announcements on the admin dashboard",
    "keywords": [
        "filament",
        "filament-plugin",
        "filament-v5",
        "laravel",
        "dashboard",
        "announcements",
        "alerts"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Marcelo Delgado",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Marcelodelgado\\Announcements\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marcelodelgado\\Announcements\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Marcelodelgado\\Announcements\\AnnouncementsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
